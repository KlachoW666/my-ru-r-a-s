# Windows-машина разработки против Linux-сервера.
#
# Без этого файла git отдаёт рабочей копии CRLF, и на сервере шебанг
# `#!/usr/bin/env bash\r` превращается в «bad interpreter: no such file
# or directory». То же ломает юниты systemd и конфиги nginx.
* text=auto

*.sh              text eol=lf
*.service         text eol=lf
*.conf            text eol=lf
.env.example      text eol=lf

# Собранный бандл и картинки трогать нельзя ни при каких настройках.
*.sqlite          binary
*.webp            binary
*.png             binary
*.jpg             binary
*.jpeg            binary
*.ico             binary
*.woff            binary
*.woff2           binary
*.ogg             binary
*.mp3             binary
