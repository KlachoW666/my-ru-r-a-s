# Скопируй в .env и подставь боевые значения.
# .env в git не попадает (см. .gitignore).

# --- Игровой сервер (server.js) ---
NODE_ENV=production
PORT=3101

# Канонический адрес сайта. Уходит в Steam как openid.realm,
# от него же строится return_to. Должен точно совпадать с тем,
# по которому реально открывается сайт (со схемой, без слэша в конце).
PUBLIC_URL=https://titanrust.ru

# Куда разрешено редиректить после логина (через запятую, сверх PUBLIC_URL).
ALLOWED_ORIGINS=https://www.titanrust.ru

# Домен cookie сессии. Точка в начале покрывает www и поддомены.
COOKIE_DOMAIN=.titanrust.ru

# Ключ Steam Web API (нужен для ника и аватара).
# Получить / отозвать: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Секрет подписи JWT. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=2592000

# 1 — отдавать моковый профиль без токена. Только для локальной разработки.
# При NODE_ENV=production по умолчанию выключено.
ALLOW_MOCK_AUTH=0

# --- Сервер админки (admin.titanrust.ru/server) ---
ADMIN_PORT=8080
# JWT_SECRET читается из той же переменной
# ADMIN_REQUIRE_AUTH=1 — включить реальную проверку JWT на /api/v1/admin/*
ADMIN_REQUIRE_AUTH=0
# Роль, от имени которой работает админка при ADMIN_REQUIRE_AUTH=0.
# Нужна, чтобы проверять права локально, не заводя passkey.
# SUPER_ADMIN | ADMIN | FINANCE | MODERATOR | VIEWER
ADMIN_DEV_ROLE=SUPER_ADMIN

# --- Каталог предметов Steam (services/steamCatalog.js) ---
# 0 — не запускать фоновый обход каталога
STEAM_CATALOG_SYNC=1
# Пауза между запросами к Steam, мс. Ниже 2000 — реальный риск HTTP 429 и
# временной блокировки IP. 3000 => полный круг по 5430 предметам ~27 мин.
STEAM_REQUEST_INTERVAL_MS=3000
# Пауза между полными кругами, мс
STEAM_SWEEP_PAUSE_MS=60000
# Курс USD->RUB. Steam отдаёт цены только в USD (currency=5 игнорируется).
# Обновляется автоматически раз в 6 ч; это значение — запасное.
USD_RUB_RATE=83
# Наценка магазина к рыночной цене: 1.0 — без наценки, 1.15 — +15%
PRICE_MULTIPLIER=1
# Предметы дороже порога (₽) поднимаются в тир GOLD. 0 — отключить.
GOLD_MIN_PRICE_RUB=5000

# --- Цены и картинки из steamdataapi.com ---
# Весь каталог Rust приходит ОДНИМ запросом, цены на стороне сервиса
# обновляются каждые 5 минут. Обход Steam Market при этом не отключается:
# редкости в этом API нет, а берётся она только из name_color при обходе.
# Ключ бесплатный: https://steamdataapi.com/app
STEAMDATA_API_URL=https://steamdataapi.com/api/v1
STEAMDATA_API_KEY=
# Какое поле цены брать: median | real | latest | best | buyorder.
# median устойчива к выбросам, best — самое низкое предложение по площадкам.
# Выбор двигает всю экономику: сначала сравните, node deploy/prices.js
STEAMDATA_PRICE_FIELD=median
# Как часто обновлять цены, мс. 0 — только вручную.
STEAMDATA_REFRESH_MS=900000

# --- Вход в админку по passkey (WebAuthn) ---
# RP ID обязан совпадать с доменом в адресной строке браузера.
# Для локальной регистрации ключа: ADMIN_RP_ID=localhost
ADMIN_RP_ID=titanrust.ru
ADMIN_ORIGINS=https://admin.titanrust.ru,https://titanrust.ru
# ADMIN_ORIGINS задаёт и origin'ы для passkey, и список для CORS админки.
# При NODE_ENV=production запросы с других адресов отклоняются.
# Код приглашения для регистрации ВТОРОГО и последующих ключей.
# Первый ключ заводится без него, иначе админку не поднять с нуля.
ADMIN_INVITE_CODE=
# Какой аутентификатор просить при создании ключа:
#   platform       — только встроенный (Windows Hello, Touch ID, Face ID)
#   cross-platform — только внешний (USB-брелок FIDO2, телефон по QR)
#   пусто          — решает система, доступны все способы
# Windows предлагает USB-ключ, если Windows Hello не настроен: других
# вариантов у неё нет. Тогда помогает platform либо настройка Hello.
ADMIN_PASSKEY_ATTACHMENT=

# --- Платёжный шлюз RollyPay (docs.rollypay.io) ---
# Выдаются при создании кассы. Пока пусто, пополнения принимаются заявками
# и подтверждаются вручную в админке — деньги в обход подтверждения не идут.
ROLLYPAY_API_URL=https://api.rollypay.io
ROLLYPAY_API_KEY=
ROLLYPAY_SIGNING_SECRET=
# Необязателен: ключ уже привязан к кассе.
ROLLYPAY_TERMINAL_ID=
# 1 — песочница, платежи помечаются как тестовые
ROLLYPAY_TEST=0
# Сколько заявка ждёт оплаты, минут
DEPOSIT_TTL_MINUTES=60

# --- Почта ---
# Пока SMTP_HOST пуст, коды подтверждения печатаются в лог сервера.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Kaban.gg <no-reply@titanrust.ru>
# 1 — подтверждать почту сразу, без кода (для локальной разработки)
MAIL_AUTO_VERIFY=0
